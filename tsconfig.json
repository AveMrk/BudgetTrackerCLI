{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "formatCurrency": ["./src/lib/formatCurrency.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/lib/formatCurrency.js"]
}